<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <bean name="add1" class="com.learning.model.Address">
    <property name="city" value="GZB"/>
    <property name="state" value="UP"/>
    </bean>

    <bean name="emp1" class="com.learning.model.Employee">
    <property name="id" value="111"/>
    <property name="name" value="Anup"/>
    <property name="gender" value="Male"/>
    <property name="salary" value="30000"/>
    <property name="address" ref="add1"/>
    <property name="List">
       <list>
         <value>11</value>
         <value>12</value>
         <value>13</value>
         <value>11</value>
         <value>16</value>
         <value>18</value>
         <value>11</value>
      </list>
    </property>
    
    <property name="Set">
        <set>
          <value>11</value>
          <value>12</value>
          <value>13</value>
          <value>11</value>
          <value>16</value>
          <value>18</value>
          <value>11</value>
        </set>
    </property>
    
    <property name="Map">
       <map>
         <entry key="11" value="Nakul" />
         <entry key="11" value="Aditya" />
         <entry key="13" value="Nikhil" />
         <entry key="14" value="Arjun" />
         <entry key="15" value="Swati" />    
       </map>
    </property>
    </bean>
    
    <bean name="add2" class="com.learning.model.Address">
    <constructor-arg name="city" value="Noida"/>
    <constructor-arg name="state" value="UP"/>
    </bean>
    
    <bean name="emp2" class="com.learning.model.Employee">
    <constructor-arg name="id" value="112"/>
    <constructor-arg name="name" value="Monika"/>
    <constructor-arg name="gender" value="Female"/>
    <constructor-arg name="salary" value="35000"/>
    <constructor-arg name="address" ref="add2"/> 
    <constructor-arg name="List">
       <list>
         <value>11</value>
         <value>12</value>
         <value>13</value>
         <value>11</value>
         <value>16</value>
         <value>18</value>
         <value>11</value>
      </list>
    </constructor-arg>
    
    <constructor-arg name="Set">
        <set>
          <value>11</value>
          <value>12</value>
          <value>13</value>
          <value>11</value>
          <value>16</value>
          <value>18</value>
          <value>11</value>
        </set>
    </constructor-arg>
    
    <constructor-arg name="Map">
       <map>
         <entry key="11" value="Nakul" />
         <entry key="11" value="Aditya" />
         <entry key="13" value="Nikhil" />
         <entry key="14" value="Arjun" />
         <entry key="15" value="Swati" />
       
       </map>
    </constructor-arg>

 </bean>
</beans>